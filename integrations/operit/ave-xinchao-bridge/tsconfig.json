{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "lib": ["es2020"],
    "declaration": false,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": ["../types", "./node_modules/@types"]
  },
  "include": ["./src/**/*.ts", "../types/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
